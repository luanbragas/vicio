rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de check-in — apenas participantes do desafio
    match /checkins/{desafioId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    // Fotos de perfil — apenas o próprio usuário
    match /perfis/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
